# Sketchwright Environment Variables
# Copy to .env or set in your environment if customization is needed.

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
SKETCHWRIGHT_LOG_LEVEL=INFO

# Default layout algorithm: layered, grid, tree
SKETCHWRIGHT_DEFAULT_ALGORITHM=layered

# Default layout direction: LR, RL, TB, BT
SKETCHWRIGHT_DEFAULT_DIRECTION=LR

# Geometric spacing parameters (in pixels)
SKETCHWRIGHT_NODE_SPACING=80.0
SKETCHWRIGHT_RANK_SPACING=120.0
SKETCHWRIGHT_PADDING=40.0

# Resource limits & DoS protection
SKETCHWRIGHT_MAX_INPUT_BYTES=1048576
SKETCHWRIGHT_MAX_NODES=500
SKETCHWRIGHT_MAX_EDGES=1000
SKETCHWRIGHT_MAX_LABEL_LENGTH=256

# Filesystem boundary isolation (restricts file output paths to an authorized directory)
# SKETCHWRIGHT_ALLOWED_DIR=/path/to/authorized/workspace
